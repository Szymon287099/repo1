               CNT_OUT : out STD_LOGIC_VECTOR (7 downto 0));
    end component;

    signal clk     : std_logic := '0';
    signal rst     : std_logic := '1';
    signal DIR     : std_logic := '1';
    signal CNT_OUT : std_logic_vector(7 downto 0);
begin
    uut: counter port map (clk => clk, rst => rst, DIR => DIR, CNT_OUT => CNT_OUT);

    clk_proc: process
    begin
        wait for 5 ns;
        clk <= not clk;
    end process;

    stim_proc: process
    begin
        rst <= '1';
        wait for 25 ns;
        rst <= '0';
        DIR <= '1';
        wait for 300 ns;
        DIR <= '0';
        wait for 300 ns;
        rst <= '1';
        wait for 30 ns;
        rst <= '0';
        wait;
    end process;
