bool wyszLiniowe(std::vector<int> vec, int x) {
    for (int i : vec) {
        if (i == x) {
            return true;
        }
    }
    return false;
}

bool wyszBinarne(std::vector<int> vec, int x) {
    int bottom = 0;
    int top = vec.size() - 1;
    while (bottom <= top) {
        int mid = bottom + (top - bottom) / 2;
        if (x == vec[mid]) {
            return true;
        } else if (x > vec[mid]) {
            bottom = mid + 1;
        } else {
            top = mid - 1;
        }
    }
    return false;
}

int longestZeros(std::vector<int> vec) {
    int x = 0;
    int maxZeros = 0;
    bool jedynka = false;
    for (int i : vec) {
        if (i == 1) {
            jedynka = true;
            x = 0;
        } else if (i == 0 && jedynka) {
            x++;
            if (x > maxZeros) {
                maxZeros = x;
            }
        } else {
            jedynka = false;
            x = 0;
        }
    }
    return maxZeros;
}

std::vector<int> twoSum(std::vector<int>& nums, int target) {
    for (int i = 0; i < nums.size(); i++) {
        for (int j = i + 1; j < nums.size(); j++) {
            if (nums[i] + nums[j] == target) {
                return {i, j};
            }
        }
    }
}

